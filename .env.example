# Cadena de MongoDB Atlas. Si la contraseña tiene caracteres especiales, hay que
# codificarlos en la URL (por ejemplo @ se escribe %40).
MONGODB_URI=

# Nombre de la base. Si lo dejas vacío, se usa el de la URI y, si no trae ninguno, "lol".
MONGODB_DB=lol

# Opcional. Si tiene valor, PATCH y PUT tienen que enviar la cabecera x-api-key.
# Si lo dejas vacío, cualquiera que conozca la URL puede modificar oro, jugadores, campeones e ítems.
API_WRITE_KEY=

# Opcional. Sincronización en vivo entre pestañas vía Ably (necesario en Vercel, que no
# admite WebSocket propio). Key de ably.com → tu app → API Keys, con permisos Publish y Subscribe.
# Solo la usa el servidor; el navegador recibe tokens cortos de /api/live-token.
# Si lo dejas vacío, en local se usa el WebSocket de `npm run dev:api` y en Vercel no hay sync en vivo.
ABLY_API_KEY=

# Opcional. Canal de Ably (por defecto lol-dnd).
ABLY_CHANNEL=
