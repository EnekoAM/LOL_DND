{
  "name": "lol-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:api": "set NODE_OPTIONS=--use-system-ca&& tsx server/dev.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "seed": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/seed.ts",
    "migrate:sheets": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-sheets.ts",
    "migrate:roles": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-roles.ts",
    "migrate:loot": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-loot-rules.ts",
    "migrate:ranks": "set NODE_OPTIONS=--use-system-ca&& tsx scripts/migrate-ability-ranks.ts",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@3d-dice/theme-default-extras": "^0.1.1",
    "express": "^4.22.3",
    "framer-motion": "^12.23.26",
    "google-map-react": "^2.2.5",
    "mongodb": "^7.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.9.4",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/express": "^4.17.25",
    "@types/google-map-react": "^2.1.10",
    "@types/node": "^26.6.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.2.0",
    "vite": "^5.0.0"
  }
}
